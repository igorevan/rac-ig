  fhir:concept ( [
     fhir:code [ fhir:v "10002198" ] ;
     fhir:display [ fhir:v "Anafilaxia" ] ;
     fhir:definition [ fhir:v "Anafilaxia é uma reação alérgica aguda e grave que começa subitamente, entre menos de um minuto e até algumas horas após a exposição a um alérgeno, ao qual a pessoa desenvolveu hipersensibilidade, e que pode ser fatal." ]
  ] [
     fhir:code [ fhir:v "10002424" ] ;
     fhir:display [ fhir:v "Angioedema" ] ;
     fhir:definition [ fhir:v "Edema súbito da derme, tecido subcutâneo, mucosa e tecido submucoso." ]
  ] [
     fhir:code [ fhir:v "10003246" ] ;
     fhir:display [ fhir:v "Artrite" ] ;
     fhir:definition [ fhir:v "Inflamação numa ou mais articulações." ]
  ] [
     fhir:code [ fhir:v "10003553" ] ;
     fhir:display [ fhir:v "Asma" ] ;
     fhir:definition [ fhir:v "Asma é uma doença inflamatória das vias aéreas." ]
  ] [
     fhir:code [ fhir:v "10006482" ] ;
     fhir:display [ fhir:v "Broncoespasmo" ] ;
     fhir:definition [ fhir:v "Estreitamento do lúmen brônquico, em consequência da contração da musculatura brônquica." ]
  ] [
     fhir:code [ fhir:v "10010741" ] ;
     fhir:display [ fhir:v "Conjuntivite" ] ;
     fhir:definition [ fhir:v "Inflamação da conjuntiva." ]
  ] [
     fhir:code [ fhir:v "10003639" ] ;
     fhir:display [ fhir:v "Dermatite atópica" ] ;
     fhir:definition [ fhir:v "Caracteriza-se pela presença de erupções pruriginosas e com crosta." ]
  ] [
     fhir:code [ fhir:v "10012442" ] ;
     fhir:display [ fhir:v "Dermatite de contato" ] ;
     fhir:definition [ fhir:v "Reação inflamatória que ocorre devido ao contato da pele com um agente irritante." ]
  ] [
     fhir:code [ fhir:v "10012735" ] ;
     fhir:display [ fhir:v "Diarréia" ] ;
     fhir:definition [ fhir:v "Evacuação de fezes líquidas de forma frequente e sem controle, podendo ser aguda ou crônica" ]
  ] [
     fhir:code [ fhir:v "10013968" ] ;
     fhir:display [ fhir:v "Dispnéia" ] ;
     fhir:definition [ fhir:v "É uma sensação de dificuldade em respirar." ]
  ] [
     fhir:code [ fhir:v "10014184" ] ;
     fhir:display [ fhir:v "Eczema" ] ;
     fhir:definition [ fhir:v "Tipo de inflamação cutânea." ]
  ] [
     fhir:code [ fhir:v "10023845" ] ;
     fhir:display [ fhir:v "Edema de Glote" ] ;
     fhir:definition [ fhir:v "Edema súbito da glote que impede a passagem de ar." ]
  ] [
     fhir:code [ fhir:v "10015218" ] ;
     fhir:display [ fhir:v "Eritema Multiforme" ] ;
     fhir:definition [ fhir:v "Reação imunológica da pele e mucosas." ]
  ] [
     fhir:code [ fhir:v "10012441" ] ;
     fhir:display [ fhir:v "Exantema bolhoso" ] ;
     fhir:definition [ fhir:v "Erupção cutânea constituída por bolhas." ]
  ] [
     fhir:code [ fhir:v "10037868" ] ;
     fhir:display [ fhir:v "Exantema maculopapular" ] ;
     fhir:definition [ fhir:v "Erupção cutânea que se caracteriza pelo aparecimento de manchas e pápulas eritematosas." ]
  ] [
     fhir:code [ fhir:v "10034972" ] ;
     fhir:display [ fhir:v "Fotossensibilidade" ] ;
     fhir:definition [ fhir:v "Queimaduras ou outras reações cutâneas desencadeadas pela exposição aos raios ultravioleta." ]
  ] [
     fhir:code [ fhir:v "10028116" ] ;
     fhir:display [ fhir:v "Mucosite" ] ;
     fhir:definition [ fhir:v "A mucosite é uma inflamação da mucosa do tubo digestivo." ]
  ] [
     fhir:code [ fhir:v "10029117" ] ;
     fhir:display [ fhir:v "Nefrite" ] ;
     fhir:definition [ fhir:v "Processo inflamatório localizado ao rim." ]
  ] [
     fhir:code [ fhir:v "10007617" ] ;
     fhir:display [ fhir:v "Parada Cardiorespiratória" ] ;
     fhir:definition [ fhir:v "Interrupção súbita da circulação sanguínea e dos movimentos respiratórios." ]
  ] [
     fhir:code [ fhir:v "10037087" ] ;
     fhir:display [ fhir:v "Prurido" ] ;
     fhir:definition [ fhir:v "Sensação de irritação intensa da pele, que induz a coceira." ]
  ] [
     fhir:code [ fhir:v "10039083" ] ;
     fhir:display [ fhir:v "Rinite" ] ;
     fhir:definition [ fhir:v "Irritação e inflamação crônica ou aguda da mucosa nasal." ]
  ] [
     fhir:code [ fhir:v "10073508" ] ;
     fhir:display [ fhir:v "Síndrome de DRESS" ] ;
     fhir:definition [ fhir:v "Reação adversa sistêmica a um fármaco, consistindo em erupções cutâneas graves, febre, adenopatias, hepatite e alterações hematológicas (hipereosinofilia e linfocitose atípica)." ]
  ] [
     fhir:code [ fhir:v "10044223" ] ;
     fhir:display [ fhir:v "Síndrome de Lyell" ] ;
     fhir:definition [ fhir:v "Lesão dermatológica rara, de extrema gravidade, caracterizada pelo aparecimento súbito de febre elevada, sinais de toxicidade sistémica e exfoliação mucocutânea intensa." ]
  ] [
     fhir:code [ fhir:v "10042033" ] ;
     fhir:display [ fhir:v "Síndrome de Stevens-Johnson" ] ;
     fhir:definition [ fhir:v "Erupções cutâneas generalizadas, febre, mucosite oral e conjuntivite purulenta graves." ]
  ] [
     fhir:code [ fhir:v "10011224" ] ;
     fhir:display [ fhir:v "Tosse" ] ;
     fhir:definition [ fhir:v "Resposta reflexa ou voluntária do organismo, resultante de irritação das vias áreas e que funciona como uma contração espasmódica e normalmente repetitiva, do tórax." ]
  ] [
     fhir:code [ fhir:v "10046735" ] ;
     fhir:display [ fhir:v "Urticária" ] ;
     fhir:definition [ fhir:v "Tipo de erupção cutânea, pruriginosa, caracterizada por placas salientes, que se assemelham às produzidas pela urtiga." ]
  ] [
     fhir:code [ fhir:v "10047115" ] ;
     fhir:display [ fhir:v "Vasculite" ] ;
     fhir:definition [ fhir:v "Inflamação vascular, que pode estender-se ao endotélio, causando estenose e/ou oclusão." ]
  ] [
     fhir:code [ fhir:v "10047700" ] ;
     fhir:display [ fhir:v "Vômito" ] ;
     fhir:definition [ fhir:v "É a expulsão ativa do conteúdo gástrico pela boca." ]
  ] ) . # 

